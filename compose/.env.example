# ─────────────────────────────────────────────────────────────────────
# Environment variables for the Enterprise AI & RAG Platform
# Copy to .env and customize for your environment.
# ─────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_USER=app_admin
POSTGRES_PASSWORD=changeme_prod

# ── Security (MUST CHANGE in production) ─────────────────────────────
# Fernet master key for credential encryption at rest (32+ bytes URL-safe)
MASTER_KEY=generate-with:python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# JWT signing secret (use a long random string)
JWT_SECRET_KEY=generate-with:python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_EXPIRE_MINUTES=480
JWT_REFRESH_EXPIRE_MINUTES=43200
MIN_PASSWORD_LENGTH=12

# ── Application ──────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
API_PORT=8000

# ── Model Gateway ────────────────────────────────────────────────────
# Options: hermes, ollama, openai_compatible
DEFAULT_PROVIDER=hermes
DEFAULT_MODEL=hermes-agent
REMOTE_MODEL_ALLOWED=false

# Hermes API server (running on host, not in container)
HERMES_API_BASE=http://host.docker.internal:8642/v1
HERMES_API_KEY=

# Ollama (if using local inference)
OLLAMA_API_BASE=http://ollama:11434/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma:2b

# OpenAI-compatible (if using cloud provider)
OPENAI_COMPATIBLE_BASE=
OPENAI_COMPATIBLE_KEY=
OPENAI_COMPATIBLE_MODEL=

# ── Embedding ────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-V2
EMBEDDING_DIMENSIONS=384

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# ── Structured Data ──────────────────────────────────────────────────
# Customer database connection (separate from application database)
# In production, this should point to a read-only database account
STRUCTURED_DATA_DB_URL=postgresql+asyncpg://app_admin:changeme_prod@postgres:5432/enterprise_ai
STRUCTURED_DATA_SCHEMA=public
STRUCTURED_DATA_MAX_ROWS=1000
STRUCTURED_DATA_QUERY_TIMEOUT=30

# ── Job Queue ────────────────────────────────────────────────────────
JOB_MAX_RETRIES=3
JOB_TIMEOUT_SECONDS=600

# ── Audit ────────────────────────────────────────────────────────────
AUDIT_RETENTION_DAYS=365
FULL_PROMPT_LOGGING_ENABLED=false
